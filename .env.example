CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Khalti (Nepal payment gateway)
# Sandbox dashboard: https://khalti.com/merchant-dashboard/
# API docs: https://docs.khalti.com/
# -----------------------------------------------------------------------------
KHALTI_SECRET_KEY=your_khalti_secret_key_here
KHALTI_PUBLIC_KEY=your_khalti_public_key_here

# eSewa (Nepal payment gateway)
# Sandbox dashboard: https://esewa.com.np/merchant-dashboard/
# API docs: https://developer.esewa.com.np/
# -----------------------------------------------------------------------------
ESEWA_MERCHANT_CODE=your_esewa_merchant_code_here
ESEWA_SECRET_KEY=your_esewa_secret_key_here

# Payment redirect URLs (Khalti/eSewa redirect here after payment)
# -----------------------------------------------------------------------------
PAYMENT_SUCCESS_URL=
PAYMENT_FAILURE_URL=
 
 # NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# App URL (used by payment gateways for redirect URLs)
NEXT_PUBLIC_APP_URL=